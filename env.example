# Connect an Upstash Redis database through Vercel Marketplace, or set these manually.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Marketplace KV_REST_API_URL / KV_REST_API_TOKEN aliases are also supported.

# Required: an actual, approved, direct HTTPS CSV download URL.
# Oracle's public downloads are hosted on linked Google Drive; live verification is pending access approval.
ORACLES_CSV_URL=

# Generate a long random secret and set it in Vercel for the daily cron request.
CRON_SECRET=

# Optional key isolation if sharing Redis with other applications.
FANTASY_STORE_PREFIX=fantasy-worlds
